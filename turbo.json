{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "AUTH_TRUST_HOST",
    "NEXTAUTH_URL",
    "NEXTAUTH_SECRET",
    "AUTH_SECRET",
    "DATABASE_URL",
    "DIRECT_URL",
    "ENCRYPTION_SECRET",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "GITHUB_TOKEN",
    "GITHUB_REPO",
    "ONEDRIVE_CLIENT_ID",
    "ONEDRIVE_CLIENT_SECRET",
    "ONEDRIVE_DIRECTORY_TENANT_ID",
    "DROPBOX_CLIENT_ID",
    "DROPBOX_CLIENT_SECRET",
    "NOTION_CLIENT_ID",
    "NOTION_CLIENT_SECRET",
    "NOTION_DEFAULT_DATABASE_ID",
    "EXTENSION_ALLOWED_ORIGINS",
    "EXTENSION_JWT_SECRET",
    "EXTENSION_TOKEN_TTL",
    "EXTENSION_TOKEN_MAX_TTL",
    "CHROME_WEB_STORE_EXTENSION_ID",
    "CHROME_EXTENSION_SLUG",
    "VITE_API_BASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**", 
        "!.next/cache/**", 
        "dist/**", 
        "build/**", 
        "styles/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "format": {
      "outputs": []
    }
  }
}
