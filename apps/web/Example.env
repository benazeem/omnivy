# ─── Application ────────────────────────────────────────────
NEXTAUTH_SECRET=your-nextauth-secret-generate-with-openssl-rand-base64-32
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── PostgreSQL / Neon ──────────────────────────────────────
DATABASE_URL= 
DIRECT_URL=  

# ─── Token Encryption (AES-256-GCM) ────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET=your-64-character-hex-encryption-key

# ─── Auth.js Identity Providers ─────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Microsoft OneDrive
ONEDRIVE_CLIENT_ID=your-onedrive-client-id
ONEDRIVE_CLIENT_SECRET=your-onedrive-client-secret

# Dropbox
DROPBOX_CLIENT_ID=your-dropbox-app-key
DROPBOX_CLIENT_SECRET=your-dropbox-app-secret

# Notion
NOTION_CLIENT_ID=your-notion-integration-client-id
NOTION_CLIENT_SECRET=your-notion-integration-client-secret
NOTION_DEFAULT_DATABASE_ID=your-default-notion-database-id

# Comma-separated list of origins allowed to call integration APIs from an extension.
# Example: chrome-extension://abcdefghijklmnop,moz-extension://1234567890abcdef
EXTENSION_ALLOWED_ORIGINS=

# Secret used to sign short-lived JWTs issued to the extension. Must be kept safe.
EXTENSION_JWT_SECRET=your-very-secret-key-for-hs256
# Default TTL (seconds) for extension tokens. Recommended 300-1800 (5-30 minutes).
EXTENSION_TOKEN_TTL=900
# Maximum TTL the server will honor (seconds)
EXTENSION_TOKEN_MAX_TTL=1800

GITHUB_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GITHUB_REPO=benazeem/obsidianplus

# Chrome Web Store listing used for install-page stats.
CHROME_WEB_STORE_EXTENSION_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
CHROME_EXTENSION_SLUG=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
