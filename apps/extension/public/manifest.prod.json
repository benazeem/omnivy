{
  "manifest_version": 3,
  "name": "Omnivy Web Clipper",
  "version": "2.0.0",
  "description": "Clip web content to Obsidian and Notion with ease. Supports Google Drive, Dropbox, and OneDrive.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "contextMenus",
    "cookies"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "settings.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "https://omnivy.hawebstudio.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "settings.html",
        "popup.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
